# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose this to the browser — it bypasses RLS.
# Used solely by /api/admin/create-user to make guest accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: serve the guide under a sub-path, e.g. /ishigaki
# NEXT_PUBLIC_BASE_PATH=/ishigaki
